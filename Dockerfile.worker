FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-full.txt .

# The worker host is CPU-only. Use the official CPU wheel on ARM64 instead of
# the PyPI default, which currently pulls CUDA runtimes for this architecture.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    "torch==2.14.1+cpu" && \
    pip install --no-cache-dir -r requirements-full.txt

COPY . .

CMD ["python", "src/messaging/consumers.py"]
